<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenSense.App.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenSense.App.Views"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:OpenSense.App.ViewModels">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Line icons drawn on a 24 x 24 grid, so they follow the theme's text colour and scale cleanly. -->
            <Style x:Key="WidgetIconStyle" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
            </Style>
        </Grid.Resources>

        <!-- Sized to its content (see WidgetWindow.FitToContent), so the window is exactly as tall as what it shows. -->
        <Grid
            x:Name="ContentHost"
            Padding="14,0,14,14"
            VerticalAlignment="Top"
            RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The drag handle; the window's own close button sits at the right and hides the widget. -->
            <Grid
                x:Name="DragArea"
                Height="36"
                Background="Transparent"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M13,2.5 L5,13.5 h6 l-1,8 l8,-11 h-6 z" Style="{StaticResource WidgetIconStyle}" Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Canvas>
                </Viewbox>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="OpenSense" />
            </Grid>

            <!-- CPU and GPU: temperature, power and load -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12,10" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M7,7 h10 v10 h-10 z M10,10 h4 v4 h-4 z M9,3 v4 M15,3 v4 M9,17 v4 M15,17 v4 M3,9 h4 M3,15 h4 M17,9 h4 M17,15 h4" Style="{StaticResource WidgetIconStyle}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="CpuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionMutedStyle}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionMutedStyle}" Text="{x:Bind Monitor.CpuLoadText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            FontSize="34"
                            Foreground="{x:Bind local:WidgetWindow.TemperatureBrush(Monitor.CpuTemperatureValue), Mode=OneWay}"
                            Style="{StaticResource BigNumberStyle}"
                            Text="{x:Bind Monitor.CpuTemperatureText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M13,2.5 L5,13.5 h6 l-1,8 l8,-11 h-6 z" Style="{StaticResource WidgetIconStyle}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Monitor.CpuPowerText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="12,10" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M2.5,6.5 h19 v10 h-19 z M13.5,11.5 a3.2,3.2 0 1 1 -6.4,0 a3.2,3.2 0 1 1 6.4,0 M16.5,10 h2.5 M16.5,13 h2.5 M5.5,16.5 v3 h13 v-3" Style="{StaticResource WidgetIconStyle}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="GpuLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionMutedStyle}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionMutedStyle}" Text="{x:Bind Monitor.GpuLoadText, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            FontSize="34"
                            Foreground="{x:Bind local:WidgetWindow.TemperatureBrush(Monitor.GpuTemperatureValue), Mode=OneWay}"
                            Style="{StaticResource BigNumberStyle}"
                            Text="{x:Bind Monitor.GpuTemperatureText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M13,2.5 L5,13.5 h6 l-1,8 l8,-11 h-6 z" Style="{StaticResource WidgetIconStyle}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Monitor.GpuPowerText, Mode=OneWay}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionMutedStyle}" Text="{x:Bind Monitor.GpuPowerLimitText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fan speeds -->
            <ItemsControl Grid.Row="2" HorizontalAlignment="Center" ItemsSource="{x:Bind Monitor.Fans}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FanReadingViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource CaptionMutedStyle}" Text="{x:Bind ShortName}" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind RpmText, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fan mode and GPU overclock -->
            <Border Grid.Row="3" Padding="12,10" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="10" Visibility="{x:Bind Fans.HasFans, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox x:Name="FanIcon" Width="18" Height="18" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12.00,11.00 C10.50,6.00 13.50,2.80 17.00,3.80 C18.20,6.80 15.50,10.20 12.00,11.00 zM12.87,12.50 C17.95,13.70 19.22,17.90 16.60,20.43 C13.40,19.97 11.81,15.93 12.87,12.50 zM11.13,12.50 C7.55,16.30 3.28,15.30 2.40,11.77 C4.40,9.23 8.69,9.87 11.13,12.50 z M13.2,12 a1.2,1.2 0 1 1 -2.4,0 a1.2,1.2 0 1 1 2.4,0" Style="{StaticResource WidgetIconStyle}" />
                            </Canvas>
                        </Viewbox>
                        <toolkit:Segmented
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind vm:FanControlViewModel.ModeNames}"
                            SelectedIndex="{x:Bind Fans.ModeIndex, Mode=TwoWay}" />
                    </Grid>
                    <Grid ColumnSpacing="10" Visibility="{x:Bind Gpu.Available, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4.2,18 a9,9 0 1 1 15.6,0 M12,13 L16.2,8.2 M12,13.9 a0.9,0.9 0 1 1 0,-0.01" Style="{StaticResource WidgetIconStyle}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="OverclockLabel" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" />
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            IsOn="{x:Bind Gpu.Enabled, Mode=OneWay}"
                            Toggled="OnOverclockToggled" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
